rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    // Public catalog data — anyone can read, only admins can write
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /brands/{brandId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /blogPosts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /coupons/{code} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Reviews — signed-in users can create, only admins can moderate/delete
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Orders — customers can create + read their own; only admins can update status / read all
    match /orders/{orderId} {
      allow create: if true; // guest checkout allowed
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Customers — user can read/write their own profile; admins can read/write all
    match /customers/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    // Carts / wishlists — private to the owning user
    match /carts/{uid} {
      allow read, write: if isOwner(uid);
    }
    match /wishlists/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Admins collection — only readable/writable by existing admins (bootstrap the first
    // admin manually from the Firebase Console: Firestore -> admins -> add doc with your uid)
    match /admins/{uid} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
